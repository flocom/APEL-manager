# ------------------------------------------------------------------
# Base de données — Neon Postgres
# (récupérer la "Connection string" pooled dans le dashboard Neon)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------
# Authentification
# AUTH_SECRET : chaîne aléatoire >= 32 caractères. Générer avec :
#   openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="change-me-with-a-long-random-string-min-32-chars"

# URL publique du site (utilisée dans les e-mails et liens d'inscription)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Notifications — toutes optionnelles.
# Si non renseignées, le canal correspondant est simplement ignoré.
# ------------------------------------------------------------------

# E-mail via Resend (https://resend.com) — gratuit jusqu'à 3000 mails/mois
RESEND_API_KEY=""
# Adresse d'expéditeur (doit être vérifiée sur Resend, ou onboarding@resend.dev en test)
EMAIL_FROM="APEL Manager <onboarding@resend.dev>"

# Telegram — créer un bot via @BotFather
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------
# CRON — secret protégeant l'endpoint de notifications.
# Vercel envoie automatiquement l'en-tête Authorization: Bearer <CRON_SECRET>.
# Générer avec : openssl rand -base64 32
# ------------------------------------------------------------------
CRON_SECRET="change-me-cron-secret"

# Fenêtre de rappel : nb de jours avant l'échéance d'une tâche pour envoyer un rappel
REMINDER_WINDOW_DAYS="3"
