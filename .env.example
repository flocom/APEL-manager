# Copiez ce fichier une seule fois en `.env`. Les mêmes noms sont utilisés par
# Node.js, Docker Compose et les hébergeurs. L'identité, les rappels, Telegram,
# Resend/SMTP et l'expéditeur se configurent dans /dashboard/settings.

# ------------------------------------------------------------------
# URL publique et base de données
# ------------------------------------------------------------------
APP_URL="http://localhost:3000"

# Laisser vide pour utiliser le PostgreSQL inclus dans Docker. Hors Docker,
# renseigner une URL PostgreSQL joignable (par exemple une URL pooled Neon).
DATABASE_URL=""
DATABASE_POOL_MAX="10"

# PostgreSQL inclus dans Docker uniquement. Utiliser un mot de passe unique en
# production ; ces trois valeurs servent aussi à construire DATABASE_URL dans
# le conteneur quand elle est vide.
POSTGRES_DB="apel_manager"
POSTGRES_USER="apel"
POSTGRES_PASSWORD="apel-local-only"

# ------------------------------------------------------------------
# Secrets de démarrage
# Générer une valeur : openssl rand -base64 48
# ------------------------------------------------------------------
# Docker génère et conserve automatiquement les valeurs laissées vides dans le
# volume app_config. Hors Docker, renseigner AUTH_SECRET,
# SETTINGS_ENCRYPTION_KEY et CRON_SECRET explicitement.
AUTH_SECRET=""
OAUTH_SECRET=""
SETTINGS_ENCRYPTION_KEY=""
CRON_SECRET=""

# Facultatif : surcharger les URLs OAuth/MCP si le connecteur utilise une autre
# origine. MCP_RESOURCE_URL doit être l'URL HTTPS exacte terminée par /api/mcp.
OAUTH_ISSUER=""
MCP_BASE_URL=""
MCP_RESOURCE_URL=""

# ------------------------------------------------------------------
# Stockage et tâches d'infrastructure
# ------------------------------------------------------------------
UPLOADS_DIR="./data/uploads"
UPLOAD_MAX_BYTES="15728640"
UPLOAD_ORPHAN_MAX_AGE_HOURS="24"
SCHEDULER_HOUR_UTC="7"
SCHEDULER_MINUTE_UTC="0"
RUN_CRON_ON_START="false"

# ------------------------------------------------------------------
# Mises à jour automatiques
# ------------------------------------------------------------------
# Activer le service `updater` : il surveille l'image publiée et remplace
# `app` et `scheduler` dès qu'une nouvelle version paraît, migrations
# comprises. Laisser vide en développement local (l'image construite depuis
# les sources serait sinon écrasée par celle du registre).
COMPOSE_PROFILES="autoupdate"

# Intervalle entre deux contrôles, en secondes (3600 = toutes les heures).
WATCHTOWER_POLL_INTERVAL="3600"

# Jeton partagé permettant d'installer une mise à jour sans attendre le
# prochain contrôle, depuis Configuration → Version et mises à jour. Laisser
# vide désactive le bouton : une mise à jour immédiate redémarre l'application.
# Générer : openssl rand -base64 32
WATCHTOWER_HTTP_API_TOKEN=""

# Dépôt et branche surveillés par l'indicateur de version de l'application.
# Mettre UPDATE_CHECK_ENABLED à "false" pour supprimer tout appel sortant.
UPDATE_REPOSITORY="flocom/APEL-manager"
UPDATE_CHANNEL="main"
UPDATE_CHECK_ENABLED="true"

TZ="Europe/Paris"

# ------------------------------------------------------------------
# Exposition Docker / Caddy
# ------------------------------------------------------------------
# Image utilisée par `app` et `scheduler`. La valeur par défaut pointe vers
# l'image publiée : `docker compose pull` suffit alors à récupérer la dernière
# version. Pour construire depuis les sources : `docker compose up --build`.
APEL_IMAGE="ghcr.io/flocom/apel-manager:latest"
CADDY_SITE_ADDRESS="http://localhost"
CADDY_MAX_UPLOAD_SIZE="20MB"
HTTP_PORT="3000"
HTTPS_PORT="3443"
MAILPIT_UI_PORT="8025"
