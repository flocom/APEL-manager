# ------------------------------------------------------------------
# Base de données — Neon Postgres
# (récupérer la "Connection string" pooled dans le dashboard Neon)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------
# Authentification
# AUTH_SECRET : chaîne aléatoire >= 32 caractères. Générer avec :
#   openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET="change-me-with-a-long-random-string-min-32-chars"

# Secret de signature du consentement OAuth utilisé par le connecteur MCP.
# Recommandé en production ; AUTH_SECRET sert de repli si absent.
OAUTH_SECRET="change-me-oauth-with-a-long-random-string-min-32-chars"

# Chiffre les secrets configurés depuis l'interface (notamment la clé Resend).
# Obligatoire pour les réglages dynamiques, >= 32 caractères et à conserver
# strictement identique entre les déploiements. Générer avec :
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY="change-me-with-another-random-string-min-32-chars"

# URL publique du site, configurable au démarrage en Docker.
APP_URL="http://localhost:3000"
# Compatibilité avec les anciens déploiements et éventuels composants client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pool PostgreSQL par processus (Docker : 10, environnement serverless : 1).
DATABASE_POOL_MAX="10"

# Stockage local des justificatifs et documents signés.
UPLOADS_DIR="./data/uploads"
UPLOAD_MAX_BYTES="15728640"
# Supprime chaque jour les imports annulés ou remplacés après ce délai.
UPLOAD_ORPHAN_MAX_AGE_HOURS="24"

# Facultatif : surcharger les URLs OAuth/MCP si le connecteur utilise un
# sous-domaine différent. En production, MCP_RESOURCE_URL doit pointer
# exactement vers l'endpoint public HTTPS /api/mcp.
OAUTH_ISSUER=""
MCP_RESOURCE_URL=""

# ------------------------------------------------------------------
# Personnalisation de l'association (optionnel)
# ------------------------------------------------------------------
# Nom de l'association affiché partout (défaut : "APEL Notre Dame des Flots")
NEXT_PUBLIC_ASSO_NAME=""
# Nom de l'école rattachée (défaut : "École Notre Dame des Flots")
NEXT_PUBLIC_SCHOOL_NAME=""
# E-mail de contact affiché dans les mentions / RGPD
NEXT_PUBLIC_CONTACT_EMAIL=""

# ------------------------------------------------------------------
# Notifications — toutes optionnelles.
# Si non renseignées, le canal correspondant est simplement ignoré.
# ------------------------------------------------------------------

# E-mail via Resend (https://resend.com).
# Ces deux variables restent un mode de configuration de secours. Un
# administrateur peut aussi enregistrer la clé et l'expéditeur dans
# Tableau de bord → Configuration ; la clé est alors chiffrée avec
# SETTINGS_ENCRYPTION_KEY.
RESEND_API_KEY=""
# Adresse d'expéditeur (doit être vérifiée sur Resend, ou onboarding@resend.dev en test)
EMAIL_FROM="APEL Notre Dame des Flots <onboarding@resend.dev>"

# SMTP alternatif. En Docker, Mailpit est sélectionné par défaut afin que les
# confirmations et réinitialisations soient entièrement testables localement.
# Utiliser MAIL_PROVIDER="smtp" pour activer ces paramètres.
MAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="APEL Notre Dame des Flots <noreply@localhost>"

# Telegram — créer un bot via @BotFather
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------
# CRON — secret protégeant l'endpoint de notifications.
# Vercel envoie automatiquement l'en-tête Authorization: Bearer <CRON_SECRET>.
# Générer avec : openssl rand -base64 32
# ------------------------------------------------------------------
CRON_SECRET="change-me-cron-secret"

# Fenêtre de rappel : nb de jours avant l'échéance d'une tâche pour envoyer un rappel
REMINDER_WINDOW_DAYS="3"
